{
  "rules": {
    "profiles": {
      ".read": "auth !== null",
      "$uid": {
        ".write": "$uid === auth.uid",
        "name": {
          ".validate": "newData.isString() && newData.val().length <= 128"
        },
        "photo": {
          ".validate": "newData.isString() && newData.val().length <= 1024"
        },
        "xp": {
          ".validate": "newData.isNumber()"
        }
      }
    },
    "users": {
      "$uid": {
        ".read": "$uid === auth.uid",
        ".write": "$uid === auth.uid",
        "presence": {
          ".read": "auth !== null && root.child('users').child($uid).child('friends').child(auth.uid).exists()"
        },
        "friendRequests": {
          "$fromUid": {
            ".read": "$fromUid === auth.uid",
            ".write": "auth !== null && $fromUid === auth.uid && (!newData.exists() || (root.child('users').child($uid).exists() && newData.parent().parent().parent().child($fromUid).child('sentRequests').child($uid).exists()))",
            "name": {
              ".validate": "newData.isString() && newData.val().length <= 128"
            },
            "photo": {
              ".validate": "newData.isString() && newData.val().length <= 1024"
            }
          }
        },
        "friends": {
          "$friendUid": {
            ".read": "$friendUid === auth.uid",
            ".write": "auth !== null && $friendUid === auth.uid && (!newData.exists() || root.child('users').child($uid).child('sentRequests').child(auth.uid).exists())",
            "name": {
              ".validate": "newData.isString() && newData.val().length <= 128"
            },
            "photo": {
              ".validate": "newData.isString() && newData.val().length <= 1024"
            }
          }
        },
        "sentRequests": {
          "$toUid": {
            ".read": "$toUid === auth.uid",
            ".write": "auth !== null && $toUid === auth.uid && !newData.exists()"
          }
        }
      }
    },
    "rooms": {
      ".read": "auth !== null",
      ".write": "auth !== null"
    },
    "invites": {
      ".read": "auth !== null",
      "$toUid": {
        ".write": "auth !== null && ( ($toUid === auth.uid && !newData.exists()) || (newData.exists() && newData.child('fromUid').val() === auth.uid && root.child('users').child($toUid).child('friends').child(auth.uid).exists()) || (!newData.exists() && data.child('fromUid').val() === auth.uid) )",
        "fromName": {
          ".validate": "newData.isString() && newData.val().length <= 128"
        },
        "roomCode": {
          ".validate": "newData.isString() && newData.val().length <= 16"
        }
      }
    },
    "inviteRejections": {
      ".read": "auth !== null",
      "$fromUid": {
        ".write": "auth !== null && ( ($fromUid === auth.uid && !newData.exists()) || (newData.exists() && newData.child('rejectedBy').val() === auth.uid && root.child('users').child($fromUid).child('friends').child(auth.uid).exists()) )",
        "name": {
          ".validate": "newData.isString() && newData.val().length <= 128"
        },
        "roomCode": {
          ".validate": "newData.isString() && newData.val().length <= 16"
        }
      }
    },
    "chats": {
      "$key": {
        ".read": "auth !== null && ($key.beginsWith(auth.uid + '_') || $key.endsWith('_' + auth.uid))",
        "$msgid": {
          ".write": "auth !== null && ($key.beginsWith(auth.uid + '_') || $key.endsWith('_' + auth.uid)) && !data.exists() && newData.exists() && newData.hasChildren(['fromUid', 'text', 'ts']) && newData.child('fromUid').val() === auth.uid && (!newData.child('status').exists() || newData.child('status').val() === 'sent') && root.child('users').child($key.replace(auth.uid + '_', '').replace('_' + auth.uid, '')).child('friends').child(auth.uid).exists()",
          "fromUid": {
            ".validate": "newData.isString() && newData.val().length <= 64"
          },
          "fromName": {
            ".validate": "newData.isString() && newData.val().length <= 128"
          },
          "text": {
            ".validate": "newData.isString() && newData.val().length <= 2000"
          },
          "ts": {
            ".validate": "newData.isNumber()"
          },
          "status": {
            ".write": "auth !== null && ($key.beginsWith(auth.uid + '_') || $key.endsWith('_' + auth.uid)) && data.parent().exists() && newData.exists() && data.parent().child('fromUid').val() !== auth.uid",
            ".validate": "newData.val() === 'sent' || newData.val() === 'delivered' || newData.val() === 'read'"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "chatStatus": {
      ".read": false,
      ".write": false
    },
    "dailyChallenges": {
      "$date": {
        "results": {
          ".read": "auth !== null",
          "$uid": {
            ".write": "$uid === auth.uid"
          }
        }
      }
    }
  }
}
